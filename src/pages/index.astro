---
import { getCollection, getEntry } from 'astro:content'
import { isNonEmptyArray } from 'narrowland'

import BandsLine from '@/components/BandsLine.astro'
import Claim from '@/components/Claim.astro'
import Cover from '@/components/Cover.astro'
import Gallery from '@/components/Gallery.astro'
import MusicEventSchema from '@/components/MusicEventSchema.astro'
import Layout from '@/layouts/Layout.astro'

const post = await getEntry('seasons', '2027')

if (!post) {
  return
}

const seasons = await getCollection('seasons')

const now = new Date()
const pastSeasons = seasons
  .filter((season) => season.data.startDate <= now)
  .toSorted((a, b) => Number(b.id) - Number(a.id))

const galleryImages = [
  ...new Set(pastSeasons.flatMap((season) => season.data.images ?? [])),
]
---

<Layout
  currentSeasonId={post.id}
  description={`${post.data.startDate.toLocaleDateString('cs-CZ')} – ${post.data.claim}`}
  image={`/og/${post.id}.jpg`}
>
  <MusicEventSchema slot="head" post={post} url={Astro.url} />
  <Cover
    image={post.data.cover}
    title="Malý festival"
    subtitle="na velké zahradě"
    subsubtitle={`${post.data.startDate.toLocaleDateString('cs-CZ')}, 17:00, Řevnice`}
  />
  {post.data.bands && <BandsLine bands={post.data.bands} />}

  <Claim claim={post.data.claim} />

  {isNonEmptyArray(galleryImages) && <Gallery id="vse" images={galleryImages} />}

  <div class="mx-auto my-12 max-w-xl px-4 text-center">
    <a
      href="/informace"
      class="hover inline-block border-y border-x-transparent p-2 text-2xl hover:border-y-transparent"
      >Jak to u nás chodí</a
    >
  </div>
</Layout>
